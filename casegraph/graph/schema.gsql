// CaseGraph schema. Run through casegraph.graph.setup (it substitutes @GRAPH@).
// Everything is created locally inside one graph so it works on Savanna and CE alike.

CREATE GRAPH @GRAPH@ ()
USE GRAPH @GRAPH@
CREATE SCHEMA_CHANGE JOB casegraph_schema FOR GRAPH @GRAPH@ {

  // ---------------- the bank's data ----------------
  ADD VERTEX Customer (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX Card (PRIMARY_ID id STRING, network STRING, card_type STRING, n_txn INT,
                   first_seen DATETIME, last_seen DATETIME) WITH primary_id_as_attribute="true";
  // Holder: the individual cardholder inferred behind a card (card + billing region + card-anchor day).
  ADD VERTEX Holder (PRIMARY_ID id STRING, n_txn INT, avg_amount DOUBLE, std_amount DOUBLE,
                     first_seen DATETIME, last_seen DATETIME) WITH primary_id_as_attribute="true";
  ADD VERTEX Transaction (PRIMARY_ID id STRING, ts DATETIME, amount DOUBLE, product STRING, channel STRING,
                          risk_score DOUBLE, addr1 STRING, addr2 STRING, dist1 DOUBLE, p_email STRING, r_email STRING,
                          card_network STRING, card_type STRING, c1 DOUBLE, c13 DOUBLE, c14 DOUBLE, d1 DOUBLE, d15 DOUBLE,
                          m4 STRING, m5 STRING, m6 STRING, device_status STRING, proxy_type STRING, device_type STRING,
                          id_match STRING, model_prob DOUBLE, holder_id STRING, device_id STRING)
                          WITH primary_id_as_attribute="true";
  ADD VERTEX DeviceProfile (PRIMARY_ID id STRING, n_cards INT, n_txn INT) WITH primary_id_as_attribute="true";
  ADD VERTEX EmailDomain (PRIMARY_ID id STRING, n_txn INT) WITH primary_id_as_attribute="true";
  ADD VERTEX BillingRegion (PRIMARY_ID id STRING, country STRING, n_txn INT, n_cards INT) WITH primary_id_as_attribute="true";

  ADD DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY";
  ADD DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY";
  ADD DIRECTED EDGE HAS_HOLDER (FROM Card, TO Holder) WITH REVERSE_EDGE="HOLDER_OF";
  ADD DIRECTED EDGE BY_HOLDER (FROM Transaction, TO Holder) WITH REVERSE_EDGE="HOLDER_TXN";
  ADD DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_TXN";
  ADD DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="PURCHASER_TXN";
  ADD DIRECTED EDGE RECIPIENT_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="RECIPIENT_TXN";
  ADD DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="REGION_TXN";
  ADD DIRECTED EDGE NEXT (FROM Transaction, TO Transaction, gap_s INT) WITH REVERSE_EDGE="PREV";

  // ---------------- knowledge ----------------
  ADD VERTEX Pattern (PRIMARY_ID id STRING, name STRING, description STRING, rules STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX ClosedCase (PRIMARY_ID id STRING, customer_id STRING, card_id STRING, opened_at DATETIME, closed_at DATETIME,
                         outcome STRING, pattern STRING, first_fraud_txn_id STRING, n_txns INT, exposure_usd DOUBLE,
                         actions_taken STRING, report_filed STRING, analyst_notes STRING)
                         WITH primary_id_as_attribute="true";
  ADD VERTEX DocChunk (PRIMARY_ID id STRING, source STRING, section STRING, text STRING) WITH primary_id_as_attribute="true";

  ADD DIRECTED EDGE CC_INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="IN_CLOSED_CASE";
  ADD DIRECTED EDGE CC_ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CARD_CLOSED_CASE";
  ADD DIRECTED EDGE CC_CONNECTED (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CONNECTED_CLOSED_CASE";
  ADD DIRECTED EDGE CC_PATTERN (FROM ClosedCase, TO Pattern) WITH REVERSE_EDGE="PATTERN_CLOSED_CASE";
  ADD DIRECTED EDGE DOC_PATTERN (FROM DocChunk, TO Pattern) WITH REVERSE_EDGE="PATTERN_DOC";

  // ---------------- the agent's case memory ----------------
  ADD VERTEX InvestigationCase (PRIMARY_ID id STRING, case_ref STRING, opened_at DATETIME, trigger_type STRING,
                                status STRING, verdict STRING, fraud_probability DOUBLE, pattern STRING,
                                exposure_usd DOUBLE, sar_filed BOOL, initial_actions STRING, final_actions STRING,
                                summary STRING, updated_at DATETIME) WITH primary_id_as_attribute="true";
  ADD VERTEX CaseEvent (PRIMARY_ID id STRING, step INT, kind STRING, title STRING, detail STRING)
                        WITH primary_id_as_attribute="true";
  ADD DIRECTED EDGE HAS_EVENT (FROM InvestigationCase, TO CaseEvent) WITH REVERSE_EDGE="EVENT_OF";
  ADD DIRECTED EDGE CASE_TXN (FROM InvestigationCase, TO Transaction, role STRING) WITH REVERSE_EDGE="TXN_CASE";
  ADD DIRECTED EDGE CASE_CARD (FROM InvestigationCase, TO Card, role STRING) WITH REVERSE_EDGE="CARD_CASE";
  ADD DIRECTED EDGE CASE_DEVICE (FROM InvestigationCase, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_CASE";
  ADD DIRECTED EDGE CASE_PATTERN (FROM InvestigationCase, TO Pattern) WITH REVERSE_EDGE="PATTERN_CASE";
  ADD DIRECTED EDGE CASE_CITES (FROM InvestigationCase, TO ClosedCase, similarity DOUBLE) WITH REVERSE_EDGE="CITED_BY";

}
RUN SCHEMA_CHANGE JOB casegraph_schema
DROP JOB casegraph_schema

CREATE SCHEMA_CHANGE JOB casegraph_vectors FOR GRAPH @GRAPH@ {
  // ---------------- vectors (TigerVector) ----------------
  // text embedding of closed-case narratives, policy, typologies, regulatory guidance and our own cases
  ALTER VERTEX DocChunk ADD VECTOR ATTRIBUTE emb (DIMENSION=384, METRIC="COSINE");
  ALTER VERTEX ClosedCase ADD VECTOR ATTRIBUTE emb (DIMENSION=384, METRIC="COSINE");
  ALTER VERTEX InvestigationCase ADD VECTOR ATTRIBUTE emb (DIMENSION=384, METRIC="COSINE");
  // behavioural fingerprint of an episode (channel mix, amounts, device novelty, proxy, burst shape ...)
  ALTER VERTEX ClosedCase ADD VECTOR ATTRIBUTE fp (DIMENSION=16, METRIC="COSINE");
  ALTER VERTEX InvestigationCase ADD VECTOR ATTRIBUTE fp (DIMENSION=16, METRIC="COSINE");
}
RUN SCHEMA_CHANGE JOB casegraph_vectors
DROP JOB casegraph_vectors

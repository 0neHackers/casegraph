# ---- TigerGraph -------------------------------------------------------------
# Savanna: https://<SOLUTIONID>.i.tgcloud.io  (secret from Admin Portal > User Management)
# Community Edition (Docker): http://127.0.0.1
TG_HOST=https://<SOLUTIONID>.i.tgcloud.io
TG_GRAPHNAME=CaseGraph
TG_USERNAME=
TG_PASSWORD=
TG_SECRET=
# Savanna serves REST++ and GSQL on 443
TG_RESTPP_PORT=443
TG_GS_PORT=443
TG_TGCLOUD=true

# ---- LLM (planner + case writer) ----------------------------------------------
# Leave empty to run fully offline (rule planner + templates; tokens = 0)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Agent --------------------------------------------------------------------
# true = every graph call goes through the tigergraph-mcp server (stdio)
CASEGRAPH_USE_MCP=true
GEMINI_FALLBACKS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3-flash-preview
